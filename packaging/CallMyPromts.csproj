<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <AssemblyName>CallMyPromts</AssemblyName>
    <Version>1.1.0</Version>
    <Product>CallMyPromts Paper</Product>
    <Description>Local prompt library and compact tray menu</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include=".payload/payload.zip" LogicalName="CallMyPromts.Payload" />
    <EmbeddedResource Include=".payload/manifest.json" LogicalName="CallMyPromts.Manifest" />
    <EmbeddedResource Include=".payload/payload.sha256" LogicalName="CallMyPromts.Hash" />
  </ItemGroup>
</Project>
